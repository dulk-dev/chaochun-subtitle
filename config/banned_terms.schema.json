{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dulk-dev/chaochun-subtitle/config/banned_terms.schema.json",
  "title": "Banned-term paraphrase lexicon",
  "description": "Deterministic display paraphrases applied only when burning with --paraphrase-banned-terms. strategy must stay generic-paraphrase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "strategy", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "strategy": { "const": "generic-paraphrase" },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "replace", "terms"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["guess", "confirmed"] },
          "note": { "type": "string" },
          "replace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh", "en"],
            "properties": {
              "zh": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "match": { "enum": ["phrase", "token"] },
                    "case_sensitive": { "type": "boolean" },
                    "ambiguous": { "type": "boolean" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
