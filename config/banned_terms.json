{
  "$schema": "./banned_terms.schema.json",
  "version": 1,
  "strategy": "generic-paraphrase",
  "description": "烧录时可选的显示用泛化词表。当前条目是研究整理的初始表，只做表内确定性替换。不匹配单独的字母 X。",
  "entries": [
    {
      "id": "codex",
      "status": "confirmed",
      "note": "初始表。Codex 换成通用的编程工具说法。",
      "replace": {
        "zh": "AI编程工具",
        "en": "AI coding tool"
      },
      "terms": [
        { "text": "Codex", "match": "phrase" }
      ]
    },
    {
      "id": "twitter",
      "status": "confirmed",
      "note": "初始表。只收录 Twitter、推特、X平台，不匹配单独的 X。",
      "replace": {
        "zh": "社交平台",
        "en": "social platform"
      },
      "terms": [
        { "text": "Twitter", "match": "phrase" },
        { "text": "推特", "match": "phrase" },
        { "text": "X平台", "match": "phrase" }
      ]
    },
    {
      "id": "youtube",
      "status": "confirmed",
      "note": "初始表。油管和 YouTube 共用同一组通用替换。",
      "replace": {
        "zh": "视频网站",
        "en": "video site"
      },
      "terms": [
        { "text": "YouTube", "match": "phrase" },
        { "text": "油管", "match": "phrase" }
      ]
    },
    {
      "id": "tiktok",
      "status": "confirmed",
      "note": "初始表。",
      "replace": {
        "zh": "短视频平台",
        "en": "short-video platform"
      },
      "terms": [
        { "text": "TikTok", "match": "phrase" }
      ]
    },
    {
      "id": "taobao",
      "status": "confirmed",
      "note": "初始表。",
      "replace": {
        "zh": "电商平台",
        "en": "e-commerce platform"
      },
      "terms": [
        { "text": "淘宝", "match": "phrase" }
      ]
    }
  ]
}
